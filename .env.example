# One .env at the repo root configures all three apps and the dev shell.
#
# Leave VITE_API_BASE_URL empty to run against the built-in demo (an in-memory
# copy of the backend). To use the real evolveiq-backend locally, set it to
# /api/v1: the Vite dev server forwards /api to VITE_API_PROXY_TARGET, so the
# backend needs no CORS. For a deployed build, give the full URL instead,
# e.g. https://api.evolviq.example/api/v1.
VITE_API_BASE_URL=

# Where the dev server forwards /api (local development only).
VITE_API_PROXY_TARGET=http://localhost:3000

# Show the one-tap demo accounts on the sign-in screens while connected to a
# backend filled by `npm run db:seed-demo`. Never set this for a real deployment.
VITE_SHOW_DEMO_ACCOUNTS=false
